{
	"name": "vis-bot",
	"version": "0.1.0",
	"private": true,
	"description": "Visual Snapshot PR bot",
	"keywords": [
		"actions"
	],
	"homepage": "https://github.com/repobuddy/vis-bot",
	"bugs": {
		"url": "https://github.com/repobuddy/vis-bot/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/repobuddy/vis-bot.git"
	},
	"license": "MIT",
	"author": "",
	"type": "module",
	"exports": {
		".": "./dist/index.mjs"
	},
	"scripts": {
		"all": "pnpm check:fix && pnpm test && pnpm coverage && pnpm package",
		"bundle": "pnpm check:fix && pnpm package",
		"cs": "changeset",
		"check": "biome check",
		"check:fix": "biome format --write",
		"coverage": "pnpx make-coverage-badge --output-path ./badges/coverage.svg",
		"local-action": "pnpx @github/local-action . src/main.ts .env",
		"package": "pnpm tsdown",
		"package:watch": "pnpm tsdown --watch",
		"release": "changeset publish",
		"test": "vitest",
		"version-packages": "changeset version && pnpm package",
		"w": "vitest watch"
	},
	"dependencies": {
		"@actions/core": "^3.0.1",
		"@actions/exec": "^3.0.0",
		"@actions/github": "^9.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@changesets/cli": "^2.31.1",
		"@github/local-action": "^6.0.2",
		"@repobuddy/biome": "^2.4.0",
		"@types/node": "^24.10.1",
		"make-coverage-badge": "^1.2.0",
		"tsdown": "^0.23.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	},
	"packageManager": "pnpm@11.1.3",
	"engines": {
		"node": ">=24.0.0"
	}
}
